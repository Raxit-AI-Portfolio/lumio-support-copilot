GOOGLE_CLOUD_PROJECT=your-project-id
# The agent model is served from the global endpoint only (404 in us-central1)
MODEL=gemini-3.5-flash-lite
MODEL_LOCATION=global
# Embeddings use a regional endpoint
EMBED_MODEL=gemini-embedding-001
EMBED_LOCATION=us-central1
# Optional. Empty = Model Armor screening off. Format: projects/<project>/locations/us-central1/templates/lumio-mvp
MODEL_ARMOR_TEMPLATE=
# Optional. Set to use the MCP read-tools server (python -m mvp.tools.mcp_server). Empty = local functions.
MCP_URL=
# Optional. 1 = search the managed Vertex AI Vector Search collection (run `python -m mvp.data.vector_search load` first). Empty = local kb_index.json.
USE_VECTOR_SEARCH=
VECTOR_REGION=us-central1
