flowchart LR
    U["Users"] --> LB["Global load balancer<br/>+ Cloud Armor<br/>one IP"]
    subgraph P["Primary us-central1 (active)"]
        direction TB
        PGW["Gateway"] --> PAE["Agent Engine"]
